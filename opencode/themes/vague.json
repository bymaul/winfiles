{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "vagueBg": "#141415",
    "vaguePanel": "#171718",
    "vagueElement": "#252530",
    "vagueBorder": "#333738",
    "vagueFg": "#cdcdcd",
