{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "arch",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": " : ",
    "color": {
      "keys": "cyan"
    },
    "key": {
      "type": "both"
    }
  },
  "modules": [
    {
      "type": "title"
    },
    {
      "type": "separator",
      "string": "-"
    },
    {
      "type": "os"
    },
    {
      "type": "kernel"
    },
    {
      "type": "uptime"
    },
    {
      "type": "packages"
    },
    {
      "type": "shell"
    },
    {
      "type": "terminal"
    },
    {
      "type": "cpu"
    },
    {
      "type": "gpu"
    },
    {
      "type": "memory"
    },
    {
      "type": "disk"
    },
    "break",
    {
      "type": "colors",
      "key": " ",
      "symbol": "block"
    }
  ]
}
